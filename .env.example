# Career360 Environment Variables
PORT=5000

# Firebase Cloud Firestore Configuration (Optional)
# Enter your Firebase project credentials to sync your data to Google Cloud Firestore.
# If left blank, Career360 automatically uses the embedded persistent local database (zero installation needed).
FIREBASE_API_KEY=AIzaSyYourApiKeyHere
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
FIREBASE_APP_ID=1:1234567890:web:abcdef123456
